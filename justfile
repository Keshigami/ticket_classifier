# standalone justfile (generated by tools/export_repo.py from the shared portfolio justfile)
set shell := ["bash", "-cu"]

setup:
    uv sync -q && mkdir -p static && cp common/ui.css static/ui.css

test:
    uv run ruff check . && uv run pytest

eval:
    uv run python eval.py

up:
    just _start 8112 .venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8112

down:
    just _stop

_start port +cmd:
    #!/usr/bin/env bash
    set -u
    cd "{{justfile_directory()}}"
    if [ -f .pid ] && kill -0 "$(cat .pid)" 2>/dev/null; then echo "already running (pid $(cat .pid)) on :{{port}}"; exit 0; fi
    nohup {{cmd}} > app.log 2>&1 &
    echo $! > .pid
    for i in $(seq 1 60); do curl -sf "http://127.0.0.1:{{port}}/" >/dev/null 2>&1 && break; sleep 0.5; done
    echo "up on http://127.0.0.1:{{port}}/ (pid $(cat .pid))"

_stop:
    #!/usr/bin/env bash
    cd "{{justfile_directory()}}"
    if [ -f .pid ]; then pid=$(cat .pid); kill "$pid" 2>/dev/null; sleep 0.5; kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null; rm -f .pid; echo "stopped (pid $pid)"; else echo "not running"; fi
